# Dependencies and build outputs
node_modules/
dist/
.venv/
.pnpm-store/
__pycache__/
.pytest_cache/
*.egg-info/
*.pyc

# Credentials and local tool configuration (never upload)
.env
.env.*
!.env.example
.codex/
.agents/
.aws/
*.pem
*.key
*.p12
*.pfx

# Runtime data, user uploads and disposable test workspaces
/data/connections/
/tmp/
*.log
playwright-report/
test-results/

# Downloaded dependency artifacts; license/hash review evidence stays tracked
*.whl

# Ephemeral workflow drafts/locks; committed progress and checkpoints stay tracked
/project-control/progress.draft.json
/project-control/checkpoint.lock

# Nonsecret local model budget/receipts; never reset to evade campaign limits
/data/model-runtime/

# User-authored semantic metadata is runtime content, not portfolio source or public fixtures
/data/semantics/

# Root-level ephemeral PDCA draft (current progress/checkpoints remain versioned)
/progress.draft.json

# Restricted source archives must stay outside this public project
/restricted/
/confidential/
/private-design/
*restricted-design-compendium*.pdf
